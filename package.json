{
  "name": "cyber-arcade-3d",
  "version": "1.2.0",
  "description": "3D WebGL Cyberpunk Arcade: Neon Snake & Turbo Highway Racer with Web Audio synth and E2E tests",
  "main": "game.js",
  "scripts": {
    "dev": "python3 -m http.server 8000",
    "check": "node --check engine.js && node --check racer-engine.js && node --check game.js",
    "test": "node --test test/*.test.js",
    "test:unit": "node --test test/engine.test.js test/modes.test.js test/racer_engine.test.js test/ui_and_buttons.test.js",
    "test:e2e": "node --test test/e2e_browser.test.js",
    "prepush": "bash scripts/pre-push.sh",
    "coderabbit:review": "bash scripts/coderabbit-check.sh",
    "sonar:check": "bash scripts/sonar-check.sh",
    "aws:deploy": "bash devops/aws/deploy-s3-cloudfront.sh",
    "aws:budget": "bash devops/aws/setup-zero-cost-budget.sh",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "keywords": [
    "snake",
    "car-racing",
    "cyberpunk",
    "webgl",
    "threejs",
    "arcade",
    "game",
    "web-audio",
    "e2e-testing",
    "cyberpunk"
  ],
  "author": "Adarsh Kshitij",
  "license": "MIT"
}
